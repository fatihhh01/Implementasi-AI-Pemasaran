    {
      "parameters": {
        "jsCode": "\nconst analisisData = $('Basic LLM Chain').first().json;\n\nconst analisis =\n  analisisData.text ||\n  analisisData.response ||\n  analisisData.output ||\n  'Hasil analisis Gemini tidak ditemukan.';\n\nconst html = `\n<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Monitoring Kompetitor NF Academy</title>\n</head>\n<body style=\"font-family: Arial, sans-serif; margin: 30px; color: #222;\">\n\n  <h1>Monitoring Kompetitor NF Academy</h1>\n  <p>Tanggal: ${new Date().toLocaleDateString('id-ID')}</p>\n\n  <hr>\n\n  <h2>Hasil Analisis Gemini</h2>\n  <div style=\"white-space: pre-wrap; line-height: 1.6;\">\n    ${String(analisis)\n      .replace(/&/g, '&amp;')\n      .replace(/</g, '&lt;')\n      .replace(/>/g, '&gt;')}\n  </div>\n\n</body>\n</html>\n`;\n\nreturn [{ json: { html } }];\n"
      },
