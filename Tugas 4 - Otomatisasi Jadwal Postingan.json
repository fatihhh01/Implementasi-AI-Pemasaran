      "parameters": {
        "jsCode": "\nconst now = new Date(\n  new Date().toLocaleString('en-US', {\n    timeZone: 'Asia/Jakarta'\n  })\n);\n\nreturn items.filter(item => {\n  const data = item.json;\n\n  if (data.Status !== 'Pending') return false;\n\n  const dateParts = String(data['Scheduled Date']).split('/');\n  const timeParts = String(data['Scheduled Time']).split(':');\n\n  if (dateParts.length !== 3 || timeParts.length < 2) {\n    return false;\n  }\n\n  const day = Number(dateParts[0]);\n  const month = Number(dateParts[1]) - 1;\n  const year = Number(dateParts[2]);\n  const hour = Number(timeParts[0]);\n  const minute = Number(timeParts[1]);\n  const second = Number(timeParts[2] || 0);\n\n  const scheduled = new Date(year, month, day, hour, minute, second);\n\n  return !isNaN(scheduled.getTime()) && scheduled <= now;\n});\n"
      },
